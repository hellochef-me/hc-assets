# SERVER-ONLY interfaces. Defaults use a read-only import or fictional local fixtures.
# Secure configuration and existing approved key reuse happen later. Do not paste keys into browser variables.
HC_ASSETS_MODE=demo
# HC_ASSETS_BACKEND=auto
# auto: authorized read-only snapshot when present, else fictional demo.
# live-readonly: existing real Sheet reads. live: approved real writes. staging: DIFFERENT test Sheet ID.
# HC_ASSETS_WRITER=direct
# HC_ASSETS_WRITES_ENABLED=approved
# HC_ASSETS_OCR_ENABLED=approved
# HC_ASSETS_RESALE_ENABLED=approved
# HC_ASSETS_ASSISTANT_ENABLED=approved
# Connected local previews must use the same Blob writer lock and AI quota as production.
# HC_ASSETS_SHARED_COORDINATION=approved
# BLOB_READ_WRITE_TOKEN=
# HC_ASSETS_REUSE_BC_CREDENTIALS=approved
# HC_ASSETS_REUSE_BC_GOOGLE=approved
# HC_ASSETS_AI_ENABLED=approved
# HC_ASSETS_AI_DAILY_REQUEST_LIMIT=20
# HC_ASSETS_AI_MINUTE_REQUEST_LIMIT=4
# OPENAI_API_KEY=
# HC_ASSETS_OPENAI_MODEL=gpt-6.1-sol
